extends ../layout

block content
	- const r = (resource && resource.metadata && resource.metadata.resource) ? resource.metadata.resource : {}
	- const submissao = (resource && resource.metadata && resource.metadata.submissao) ? resource.metadata.submissao : {}
	- const ficheiros = Array.isArray(submissao.ficheiros) ? submissao.ficheiros : []
	- const vis = r.visibilidade || 'privado'
	section.pagina-detalhe
		section.detalhe-topo
			.etiquetas
				span.etiqueta #{r.tipo || 'recurso'}
				span.etiqueta.etiqueta--vermelha #{vis}
			h1= r.titulo || 'Recurso'
			if r.subtitulo
				p.w3-large= r.subtitulo
			.conteudo-acoes
				if vis === 'publico' || user
					a.w3-button.botao-principal(href=`/resources/${resource._id}/dip`) Descarregar recurso
				else
					a.w3-button.botao-principal(href='/auth/login') Entrar para descarregar
				a.w3-button.w3-border(href='/resources') Voltar à lista

		section.detalhe-conteudo
			article.w3-white.secao-card
				h2 Informação do recurso
				if r.descricao
					p= r.descricao
				.meta-grelha
					.meta-item
						span Tipo
						strong= r.tipo || '-'
					.meta-item
						span Ano
						strong= r.ano || '-'
					.meta-item
						span Tema
						strong= r.tema || '-'
					.meta-item
						span Visibilidade
						strong= vis === 'publico' ? 'Público' : 'Privado'
					if r.dataCriacao
						.meta-item
							span Data de criação
							strong= r.dataCriacao
				if r.hashtags && r.hashtags.length
					h3 Etiquetas
					.chips-linha
						each hashtag in r.hashtags
							span.etiqueta.etiqueta--vermelha= hashtag
				if ficheiros.length
					h3 Ficheiros
					ul.lista-cards
						each ficheiro in ficheiros
							li
								strong= ficheiro.nomeOriginal || ficheiro.nomeNoPacote || 'ficheiro'
								if ficheiro.tamanho
									span.w3-text-grey.w3-small  · #{ficheiro.tamanho} bytes

				.conteudo-acoes
					if canManageResource
						a.w3-button.w3-border(href=`/resources/${resource._id}/edit`) Editar recurso
						form(action=`/resources/${resource._id}/delete` method='post')
							button.w3-button.w3-red(type='submit' onclick="return confirm('Tem a certeza que pretende eliminar este recurso? Esta ação não pode ser revertida.');") Eliminar recurso
					if user && (user.role === 'produtor' || user.role === 'admin')
						a.w3-button.w3-border(href=`/posts/new?resourceId=${resource._id}`) Criar publicação sobre este recurso

			aside.w3-white.secao-card.classificacao
				h2 Classificação
				p.w3-text-grey Avaliação média: #{rating.media} (#{rating.total} votos)

				if user
					form.formulario-compacto(action=`/resources/${resource._id}/ratings` method='post')
						label(for='stars') Classificar (1 a 5)
						select#stars.w3-select(name='stars' required)
							option(value='') Escolha
							- for (let i = 1; i <= 5; i++)
								option(value=i selected=(myRating === i))= i
						button.w3-button.botao-principal(type='submit') Guardar classificação
				else
					p.w3-text-grey Inicia sessão para classificar este recurso.

		section.w3-white.secao-card.feed-section.feed-section--resource
			.cabecalho-secao
				div
					h2 Publicações sobre este recurso
					p.w3-text-grey Conversas ligadas diretamente a este material.
				if user && (user.role === 'produtor' || user.role === 'admin')
					a.w3-button.w3-border(href=`/posts/new?resourceId=${resource._id}`) Criar publicação
			if !posts || !posts.length
				p Ainda não existem publicações associadas a este recurso.
			else
				ul.post-feed.post-feed--compact
					each post in posts
						- const autor = post.autorNome || 'autor desconhecido'
						- const inicial = autor.trim().charAt(0).toUpperCase() || 'A'
						- const conteudo = String(post.conteudo || '').trim()
						- const resumo = conteudo.length > 120 ? `${conteudo.slice(0, 120)}...` : conteudo
						li.post-feed__item
							article.post-card.post-card--compact
								.post-card__avatar= inicial
								.post-card__body
									.post-card__meta
										span Conversa
										span por #{autor}
										if post.createdAt
											time(datetime=post.createdAt)= new Date(post.createdAt).toLocaleString('pt-PT')
									h3
										a(href=`/posts/${post._id}`)= post.titulo
									if resumo
										p= resumo
									.post-card__footer
										a.post-card__link(href=`/posts/${post._id}`) Abrir conversa
