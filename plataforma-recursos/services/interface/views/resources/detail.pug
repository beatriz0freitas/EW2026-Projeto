extends ../layout

block content
	- const r = (resource && resource.metadata && resource.metadata.resource) ? resource.metadata.resource : {}
	- const vis = r.visibilidade || 'privado'
	section.card
		h1= r.titulo || 'Recurso'
		p
			strong Tipo:
			|  #{r.tipo || '-'}
		p
			strong Ano:
			|  #{r.ano || '-'}
		p
			strong Tema:
			|  #{r.tema || '-'}
		p
			strong Visibilidade:
			|  #{vis}
		if vis === 'publico' || user
			p
				a(href=`/resources/${resource._id}/dip`) Descarregar (DIP)
		else
			p.info Inicie sessão para descarregar este recurso privado.

		p.info Classificação média: #{rating.media} (#{rating.total} votos)

		if user
			form.form-inline(action=`/resources/${resource._id}/ratings` method='post')
				label(for='stars') Classificar (1 a 5)
				select#stars(name='stars' required)
					option(value='') Escolha
					- for (let i = 1; i <= 5; i++)
						option(value=i)= i
				button(type='submit') Guardar classificação
		else
			p.info Inicie sessão para classificar este recurso.

		p
			a(href='/resources') Voltar à lista

