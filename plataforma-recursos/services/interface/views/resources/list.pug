extends ../layout

block content
	section.card
		h1 Recursos educativos
		p.info Total: #{pagination.total}

		if user && (user.nivel === 'produtor' || user.nivel === 'admin')
			p
				a(href='/resources/new') Submeter recurso (SIP)

		if !items.length
			p Não existem recursos disponíveis.
		else
			table.table
				thead
					tr
						th Título
						th Tipo
						th Ano
						th Ação
				tbody
					each item in items
						- const r = (item && item.metadata && item.metadata.resource) ? item.metadata.resource : {}
						tr
							td= r.titulo || 'Sem título'
							td= r.tipo || '-'
							td= r.ano || '-'
							td
								a(href=`/resources/${item._id}`) Ver detalhe

		p.info Página #{pagination.page} de #{pagination.totalPages}

