doctype html
html(lang='pt')
	head
		meta(charset='utf-8')
		meta(name='viewport' content='width=device-width, initial-scale=1')
		title #{title || 'Plataforma de Recursos'}
		link(rel='stylesheet' href='/stylesheets/style.css')
	body.app-body
		header.app-header
			nav.app-nav(aria-label='Navegação principal')
				a.app-brand(class=isActivePath('/') ? 'is-active' : '' href='/') EW2026
				a.app-nav__link(class=isActivePath('/resources') ? 'is-active' : '' href='/resources') Recursos
				a.app-nav__link(class=isActivePath('/posts') ? 'is-active' : '' href='/posts') Publicações
				if user && user.role === 'admin'
					a.app-nav__link(class=isActivePath('/admin') ? 'is-active' : '' href='/admin/users') Administração
			.app-session
				if user
					span.app-session__name Olá, #{user.nome}
					form(action='/auth/logout' method='post')
						button.w3-button.w3-white.w3-border(type='submit') Sair
				else
					a.app-nav__link(href='/auth/login') Entrar
					a.w3-button.w3-white.w3-border(href='/auth/register') Registar

		main.w3-container.w3-padding.app-main
			if success
				div.w3-panel.w3-pale-green.w3-leftbar.w3-border-green
					p= success
			if error
				div.w3-panel.w3-pale-red.w3-leftbar.w3-border-red
					p= error

			block content

		footer.w3-container.w3-padding.w3-small.w3-text-grey
			p Plataforma EW2026 · Recursos educativos
