doctype html
html(lang='pt')
	head
		meta(charset='utf-8')
		meta(name='viewport' content='width=device-width, initial-scale=1')
		meta(name='theme-color' content='#071b3a')
		title #{title || 'Plataforma de Recursos'}
		link(rel='stylesheet' href='/stylesheets/style.css')
	body.app-body
		a.skip-link(href='#main-content') Saltar para o conteúdo
		- const roleLabel = user ? (user.role === 'admin' ? 'Administrador' : user.role === 'produtor' ? 'Produtor' : 'Consumidor') : 'Visitante'
		.app-shell
			header.app-header
				.section-shell.app-header__inner
					a.app-brand(href='/')
						span.app-brand__mark EW
						span.app-brand__text
							strong.app-brand__title Plataforma de Recursos
							span.app-brand__subtitle EW2026
					button.app-nav-toggle(type='button' aria-controls='primary-nav' aria-expanded='false' data-nav-toggle)
						span.app-nav-toggle__line
						span.app-nav-toggle__line
						span.app-nav-toggle__line
						span.sr-only Abrir navegação principal
					.app-header__panel#primary-nav(data-nav-panel)
						nav.app-nav(aria-label='Navegação principal')
							a.app-nav__link(class=isActivePath('/') ? 'is-active' : '' href='/') Início
							a.app-nav__link(class=isActivePath('/resources') ? 'is-active' : '' href='/resources') Recursos
							a.app-nav__link(class=isActivePath('/posts') ? 'is-active' : '' href='/posts') Comunidade
							if user && user.role === 'admin'
								a.app-nav__link(class=isActivePath('/admin') ? 'is-active' : '' href='/admin/users') Administração
						.app-session
							if user
								span.app-user-pill
									strong= user.nome
									small= roleLabel
								if user.role === 'produtor' || user.role === 'admin'
									a.w3-button.botao-principal.botao-principal--small(href='/resources/new') Novo recurso
								form(action='/auth/logout' method='post')
									button.w3-button.w3-white.w3-border(type='submit') Sair
							else
								a.w3-button.botao-principal.botao-principal--small(href='/auth/login') Entrar

			main#main-content.app-main
				.section-shell
					if success || error
						.section-card.flash-stack
							if success
								div.flash-message.flash-message--success(role='status')
									strong Tudo certo.
									span= success
							if error
								div.flash-message.flash-message--error(role='alert')
									strong Atenção.
									span= error
					block content

			footer.app-footer
				.section-shell.app-footer__inner
					div
						strong.app-footer__title Plataforma EW2026
						p Recursos educativos com pesquisa, partilha e contexto claro para quem navega.
						span.app-footer__subtitle Interface mais clara, rápida e centrada no essencial.
					div.app-footer__links
						a(href='/') Início
						a(href='/resources') Recursos
						a(href='/posts') Comunidade
						if user && user.role === 'admin'
							a(href='/admin/users') Administração
		script(src='/javascripts/interface.js')
		script(src='/javascripts/file-input-controls.js')
