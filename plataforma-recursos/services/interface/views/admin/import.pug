extends ../layout

block content
  section.w3-card.w3-white.w3-padding.w3-margin-top
    h1 Administração · Importar dados
    p
      a.w3-button.w3-border(href='/admin/users') Utilizadores
      a.w3-button.w3-border(href='/admin/news') Notícias
      a.w3-button.w3-border(href='/admin/data') Dados

  section.w3-card.w3-white.w3-padding.w3-margin-top
    p.w3-small
      | Os filtros abaixo são aplicados sobre o dump colado. Sem filtros, a importação continua a repor a totalidade dos dados do ficheiro.
    p.w3-small
      | Se o escopo incluir recursos, os posts, ratings, comentários e ficheiros AIP ligados a esses recursos acompanham a importação.

    if importError
      p.w3-text-red= importError

    if importResults
      if importOk
        p.w3-text-green Importacao concluida com sucesso.
      else
        p.w3-text-orange Importacao concluida com erros parciais.

      if filterSummary && filterSummary.length
        h3 Filtros aplicados
        ul.w3-ul
          each entry in filterSummary
            li
              strong= entry.label + ': '
              = entry.value

      table.w3-table-all.w3-striped
        thead
          tr.w3-teal
            th Colecao
            th Processados
            th Erros
        tbody
          each key in ['resources', 'news', 'posts', 'ratings', 'comments', 'aip']
            - var r = importResults[key] || { upserted: 0, restored: 0, errors: [] }
            - var total = key === 'aip' ? r.restored : r.upserted
            tr
              td= key
              td= total
              td
                = r.errors.length
                if r.errors.length
                  ul.w3-ul
                    each e in r.errors
                      li= e.id + ': ' + e.message

    form(method='POST' action='/admin/import')
      include data-transfer-filters.pug
      label(for='dump') JSON do dump
      textarea#dump.w3-input(
        name='dump'
        rows='20'
        placeholder='Cola aqui o conteudo do ficheiro exportado...'
        required
      )= dumpValue
      button.w3-button.w3-teal(type='submit') Importar

    p
      a.w3-button.w3-border(href='/admin/data') Voltar aos dados
