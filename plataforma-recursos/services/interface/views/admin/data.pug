extends ../layout

block content
	- const currentAdmin = 'data'
	section.admin-page
		header.admin-page-header
			div
				p.admin-eyebrow Administração
				h1 Dados
				p Exporta uma seleção ou importa um ficheiro anterior.
			include _nav.pug

		section.w3-white.secao-card
			h2 Exportar
			p.w3-text-grey Descarrega um ficheiro com os dados que queres guardar ou transferir.
			form(method='GET' action='/admin/export')
				include data-transfer-filters.pug
				.conteudo-acoes
					button.w3-button.botao-principal(type='submit') Descarregar seleção
					a.w3-button.w3-border(href='/admin/export') Exportação completa

		section.w3-white.secao-card
			h2 Importar
			p.w3-text-grey Repõe dados a partir de um ficheiro criado na exportação.
			a.w3-button.w3-border(href='/admin/import') Ir para importação
