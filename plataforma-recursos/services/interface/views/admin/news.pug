extends ../layout

block content
	section.w3-card.w3-white.w3-padding.w3-margin-top
		h1 Administração · Notícias
		p
			a.w3-button.w3-border(href='/admin/users') Utilizadores
			a.w3-button.w3-border(href='/admin/news') Notícias
			a.w3-button.w3-border(href='/admin/data') Dados
		form(action='/admin/news' method='post')
			label(for='titulo') Título
			input#titulo.w3-input(type='text' name='titulo' maxlength='160' required)

			label(for='conteudo') Conteúdo
			textarea#conteudo.w3-input(name='conteudo' rows='6' maxlength='10000' required)

			button.w3-button.w3-teal(type='submit') Criar notícia

	section.w3-card.w3-white.w3-padding.w3-margin-top
		h2 Notícias existentes
		if !items.length
			p Sem notícias publicadas.
		else
			ul.w3-ul.w3-hoverable
				each item in items
					- const eventLabel = item.eventType === 'system.new_submission' ? 'Novo recurso' : item.eventType === 'system.top3' ? 'Top 3 de recursos' : item.eventType === 'system.total_users' ? 'Utilizadores da plataforma' : ''
					- const displayTitle = item.eventType === 'system.new_submission' ? 'Novo recurso publicado' : item.eventType === 'system.top3' ? 'Recursos mais descarregados' : item.titulo
					- const displayContent = item.eventType === 'system.new_submission' && item.payload && item.payload.title ? `${item.payload.producerName || 'Alguém'} publicou o recurso "${item.payload.title}".` : item.conteudo
					li
						div
							if item.tipo === 'system'
								span.w3-tag.w3-blue-grey Automática
							else
								span.w3-tag.w3-teal Criada no painel
							if eventLabel
								span.w3-tag.w3-light-grey(style='margin-left:8px')= eventLabel
						strong= displayTitle
						p= displayContent
						if item.publicadoEm
							p.w3-text-grey.w3-small Publicado em #{new Date(item.publicadoEm).toLocaleString('pt-PT')}
						form(action=`/admin/news/${item._id}/delete` method='post')
							button.w3-button.w3-small.w3-border(type='submit') Remover
