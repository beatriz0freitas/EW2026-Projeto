extends layout

block content
	- const pageRoleLabel = user ? (user.role === 'admin' ? 'Administrador' : user.role === 'produtor' ? 'Produtor' : 'Consumidor') : 'Visitante'
	- const recentResources = Array.isArray(resources) ? resources : []
	- const latestNews = Array.isArray(news) ? news : []
	- const totalStats = stats || {}
	section.page-hero.page-hero--home.page-hero--single
		.page-hero__content
			p.page-eyebrow Plataforma educativa
			h1 Plataforma de Recursos Educativos
			p.page-hero__lead Explora materiais preservados, percebe rapidamente o contexto de cada recurso e participa sem te perder na navegação.
			if user && (user.role === 'produtor' || user.role === 'admin')
				.page-actions
					a.w3-button.botao-principal(href='/resources/new') Submeter novo recurso
			else if !user
				.page-actions
					a.w3-button.botao-principal(href='/auth/register') Criar conta
			.hero-metrics
				article.metric-card.metric-card--accent
					span.metric-card__label Recursos no catálogo
					strong.metric-card__value= totalStats.resourcesTotal || recentResources.length
				article.metric-card
					span.metric-card__label Publicações ativas
					strong.metric-card__value= totalStats.postsTotal || 0
				article.metric-card
					span.metric-card__label Tipos em destaque
					strong.metric-card__value= totalStats.resourceTypesTotal || 0
				article.metric-card.metric-card--accent
					span.metric-card__label Atualizações no mural
					strong.metric-card__value= totalStats.newsTotal || latestNews.length

	section.shortcuts-grid
		a.shortcut-card(href='/resources')
			span.shortcut-card__kicker Catálogo
			strong Recursos
			p Pesquisa simples e leitura rápida dos metadados essenciais.
		a.shortcut-card(href='/posts')
			span.shortcut-card__kicker Comunidade
			strong Publicações
			p Conversas ligadas aos recursos para perceber uso, dúvidas e contexto.
		if user && user.role === 'admin'
			a.shortcut-card(href='/admin/users')
				span.shortcut-card__kicker Gestão
				strong Administração
				p Painel central para utilizadores, notícias, dados e histórico.
		else
			a.shortcut-card(href=user ? '/posts' : '/auth/login')
				span.shortcut-card__kicker Conta
				strong #{user ? 'Continua a participar' : 'Entrar na plataforma'}
				p #{user ? `Perfil ${pageRoleLabel.toLowerCase()} com acesso rápido a comentários, classificações e publicações.` : 'Autentica-te para comentar, classificar e publicar.'}

	if latestNews.length
		section.section-card.portal-section.portal-section--news
			.cabecalho-secao
				div
					h2 Últimas notícias
					p.w3-text-grey O essencial que mudou recentemente, sem excesso de ruído.
			.news-feed
				each item in latestNews
					- const eventLabel = item.eventType === 'system.new_submission' ? 'Novo recurso' : item.eventType === 'system.top3' ? 'Top 3 de recursos' : item.eventType === 'system.total_users' ? 'Utilizadores da plataforma' : ''
					- const top3Items = item.eventType === 'system.top3' && item.payload && Array.isArray(item.payload.items) ? item.payload.items : []
					- const isTop3WithItems = item.eventType === 'system.top3' && top3Items.length
					- const displayTitle = item.eventType === 'system.new_submission' ? 'Novo recurso publicado' : item.eventType === 'system.top3' ? 'Recursos mais descarregados' : item.titulo
					- const displayContent = item.eventType === 'system.new_submission' && item.payload && item.payload.title ? `${item.payload.producerName || 'Alguém'} publicou o recurso "${item.payload.title}".` : item.conteudo

					article.news-card
						.news-card__marker
							span= item.tipo === 'system' ? 'A' : 'N'
						.news-card__main
							.news-card__meta
								if item.tipo === 'system'
									span.news-badge Automática
								else
									span.news-badge.news-badge--manual Administrador
								if eventLabel
									span.news-badge.news-badge--light= eventLabel
								if item.publicadoEm
									time(datetime=item.publicadoEm)= new Date(item.publicadoEm).toLocaleString('pt-PT')

							h3= displayTitle

							if !isTop3WithItems
								p= displayContent

							if top3Items.length
								ol.news-rank-list
									each resource, idx in top3Items
										li
											span.news-rank-list__pos #{idx + 1}
											span.news-rank-list__title= resource.titulo || 'Recurso'
											span.news-rank-list__stat #{resource.downloads || 0} desc.
											if typeof resource.ratingMedia === 'number'
												span.news-rank-list__stat avaliação #{resource.ratingMedia}

	if recentResources.length
		section.section-card
			.cabecalho-secao
				div
					h2 Recursos recentes
					p.w3-text-grey Entradas novas com leitura imediata dos aspetos mais importantes.
				a.w3-button.w3-border(href='/resources') Ver todos
			.resource-result-grid
				each item in recentResources
					- const r = (item && item.metadata && item.metadata.resource) ? item.metadata.resource : {}
					article.resource-result-card
						div.resource-result-card__meta
							span.etiqueta= r.tipo || 'Recurso'
							if r.ano
								span.etiqueta.etiqueta--subtle= r.ano
						h3
							a(href=`/resources/${item._id}`)= r.titulo || 'Sem título'
						if r.descricao
							p= r.descricao.length > 140 ? `${r.descricao.slice(0, 140)}...` : r.descricao
						else if r.tema
							p Tema principal: #{r.tema}
						.resource-result-card__footer
							if r.hashtags && r.hashtags.length
								span.resource-inline-link #{r.hashtags.slice(0, 3).join(' · ')}
							a(href=`/resources/${item._id}`) Ver detalhe
