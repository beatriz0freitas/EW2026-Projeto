extends layout

block content
	section.pagina-inicial
		section.painel-principal
			h1 Plataforma de Recursos Educativos
			p
				| Encontra, partilha e acompanha recursos com informação clara, comentários e classificações.
			.painel-principal__acoes
				a.w3-button.botao-principal(href='/resources') Explorar recursos
				a.w3-button.w3-border(href='/posts') Ver publicações
				if user && (user.role === 'produtor' || user.role === 'admin')
					a.w3-button.w3-border(href='/resources/new') Submeter recurso
				else if !user
					a.w3-button.w3-border(href='/auth/login') Entrar
			.etiquetas
				if user
					- const roleLabel = user.role === 'admin' ? 'Administrador' : user.role === 'produtor' ? 'Produtor' : 'Consumidor'
					span.etiqueta Sessão iniciada: #{roleLabel}
				else
					span.etiqueta Acesso público disponível
				span.etiqueta.etiqueta--vermelha Conteúdo preservado

		section.atalhos-grid
			a.atalho-card(href='/resources')
				strong Recursos
				span Pesquisa por tipo, ano, tema e etiqueta.
			a.atalho-card(href='/posts')
				strong Comunidade
				span Lê publicações, comentários e conversas sobre recursos.
			if user && user.role === 'admin'
				a.atalho-card(href='/admin/users')
					strong Administração
					span Gere utilizadores, notícias, exportações e importações.
			else
				a.atalho-card(href='/auth/register')
					strong Conta
					span Cria sessão para comentar, classificar e guardar atividade.

		if news && news.length
			section.w3-white.secao-card.portal-section.portal-section--news
				.cabecalho-secao
					div
						h2 Últimas notícias
						p.w3-text-grey Atualizações recentes da plataforma.
				.news-feed
					each item in news
						- const eventLabel = item.eventType === 'system.new_submission' ? 'Novo recurso' : item.eventType === 'system.top3' ? 'Top 3 de recursos' : item.eventType === 'system.total_users' ? 'Utilizadores da plataforma' : ''
						- const top3Items = item.eventType === 'system.top3' && item.payload && Array.isArray(item.payload.items) ? item.payload.items : []
						- const isTop3WithItems = item.eventType === 'system.top3' && top3Items.length
						- const displayTitle = item.eventType === 'system.new_submission' ? 'Novo recurso publicado' : item.eventType === 'system.top3' ? 'Recursos mais descarregados' : item.titulo
						- const displayContent = item.eventType === 'system.new_submission' && item.payload && item.payload.title ? `${item.payload.producerName || 'Alguém'} publicou o recurso "${item.payload.title}".` : item.conteudo

						article.news-card
							.news-card__marker
								span= item.tipo === 'system' ? 'A' : 'N'
							.news-card__main
								.news-card__meta
									if item.tipo === 'system'
										span.news-badge Automática
									else
										span.news-badge.news-badge--manual Administrador
									if eventLabel
										span.news-badge.news-badge--light= eventLabel
									if item.publicadoEm
										time(datetime=item.publicadoEm)= new Date(item.publicadoEm).toLocaleString('pt-PT')

								h3= displayTitle

								if !isTop3WithItems
									p= displayContent

								if top3Items.length
									ol.news-rank-list
										each resource, idx in top3Items
											li
												span.news-rank-list__pos #{idx + 1}
												span.news-rank-list__title= resource.titulo || 'Recurso'
												span.news-rank-list__stat #{resource.downloads || 0} desc.
												if typeof resource.ratingMedia === 'number'
													span.news-rank-list__stat avaliação #{resource.ratingMedia}

		if resources && resources.length
			section.w3-white.secao-card
				.cabecalho-secao
					div
						h2 Recursos recentes
						p.w3-text-grey Materiais adicionados recentemente.
					a.w3-button.w3-border(href='/resources') Ver todos
				ul.lista-cards
					each item in resources
						- const r = (item && item.metadata && item.metadata.resource) ? item.metadata.resource : {}
						li
							a(href=`/resources/${item._id}`)= r.titulo || 'Sem título'
							span.w3-text-grey.w3-small  · #{r.tipo || '-'}
							if r.ano
								span.w3-text-grey.w3-small  · #{r.ano}
