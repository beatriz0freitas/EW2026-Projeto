extends layout

block content
	section.card
		h1 Plataforma de Gestão e Disponibilização de Recursos Educativos
		p
			| Esta é a base da interface. O próximo passo será ligar recursos, notícias
			|  e restantes fluxos do projeto.

		if user
			p.info Está autenticado como #{user.nivel}.
		else
			p.info Está em modo anónimo. Use Entrar ou Registar para continuar.

