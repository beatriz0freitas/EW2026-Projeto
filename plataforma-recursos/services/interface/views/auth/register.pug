extends ../layout

block content
	section.card
		h1 Registar
		form.form(action='/auth/register' method='post')
			label(for='nome') Nome
			input#nome(type='text' name='nome' required)

			label(for='email') Email
			input#email(type='email' name='email' required)

			label(for='password') Password
			input#password(type='password' name='password' minlength='6' required)

			label(for='filiacao') Filiação (opcional)
			input#filiacao(type='text' name='filiacao')

			button(type='submit') Criar conta

		p.helper
			| Já tem conta?
			a(href='/auth/login') Entre aqui.

