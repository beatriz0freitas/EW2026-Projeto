extends ../layout

block content
	- const uid = user && (user._id || user.id || user.sub) ? String(user._id || user.id || user.sub) : null
	- const canManagePost = !!(user && (user.nivel === 'admin' || (uid && String(post.autorId) === uid)))
	section.card
		h1= post.titulo
		p.muted Autor: #{post.autorNome || 'desconhecido'}
		p= post.conteudo

		if canManagePost
			a(href=`/posts/${post._id}/edit`) Editar post
			form(action=`/posts/${post._id}/delete` method='post')
				button(type='submit') Remover post

	section.card
		h2 Comentários
		if !comments.length
			p Sem comentários.
		else
			ul.list
				each c in comments
					li
						strong= c.autorNome || 'utilizador'
						| : #{c.texto}
						- const canDeleteComment = !!(user && (user.nivel === 'admin' || (uid && String(c.autorId) === uid)))
						if canDeleteComment
							form(action=`/posts/${post._id}/comments/${c._id}/delete` method='post')
								button(type='submit') Remover comentário

		if user
			form.form(action=`/posts/${post._id}/comments` method='post')
				label(for='texto') Novo comentário
				textarea#texto(name='texto' rows='4' required)
				button(type='submit') Comentar
		else
			p.info Inicie sessão para comentar.

