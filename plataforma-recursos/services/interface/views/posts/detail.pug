extends ../layout

block content
	- const uid = user && (user._id || user.id || user.sub) ? String(user._id || user.id || user.sub) : null
	- const canManagePost = !!(user && (user.role === 'admin' || (uid && String(post.autorId) === uid)))
	section.pagina-detalhe
		section.detalhe-topo
			.etiquetas
				span.etiqueta Post
				span.etiqueta.etiqueta--vermelha por #{post.autorNome || 'desconhecido'}
			h1= post.titulo
			if post.resource
				p
					| Recurso associado: 
					a(href=`/resources/${post.resource._id}`)= post.resource.titulo
					if post.resource.tipo
						span.w3-text-grey  · #{post.resource.tipo}
			.conteudo-acoes
				a.w3-button.botao-claro(href='/posts') Voltar aos posts
				if canManagePost
					a.w3-button.botao-principal(href=`/posts/${post._id}/edit`) Editar post

		section.w3-card.w3-white.secao-card
			p= post.conteudo
			if canManagePost
				.conteudo-acoes
					form(action=`/posts/${post._id}/delete` method='post')
						button.w3-button.w3-red(type='submit') Remover post

		section.w3-card.w3-white.secao-card
			h2 Comentários
			if !comments.length
				p Sem comentários.
			else
				ul.lista-cards
					each c in comments
						li
							strong= c.autorNome || 'utilizador'
							| : #{c.texto}
							- const canDeleteComment = !!(user && (user.role === 'admin' || (uid && String(c.autorId) === uid)))
							if canDeleteComment
								form(action=`/posts/${post._id}/comments/${c._id}/delete` method='post')
									button.w3-button.w3-small.w3-border(type='submit') Remover comentário

			if user
				form.formulario-compacto(action=`/posts/${post._id}/comments` method='post')
					label(for='texto') Novo comentário
					textarea#texto.w3-input(name='texto' rows='4' required)
					button.w3-button.botao-principal(type='submit') Comentar
			else
				p.w3-text-grey Inicie sessão para comentar.
