extends ../layout

block content
	- const headingText = typeof heading !== 'undefined' ? heading : 'Criar publicação'
	- const formAction = typeof action !== 'undefined' ? action : '/posts'
	- const submitText = typeof submitLabel !== 'undefined' ? submitLabel : 'Publicar'
	- const p = typeof post !== 'undefined' && post ? post : {}
	section.w3-card.w3-white.secao-card.cartao-autenticacao
		h1= headingText
		form(action=formAction method='post')
			label(for='titulo') Título
			input#titulo.w3-input(type='text' name='titulo' maxlength='160' required value=(p.titulo || ''))

			label(for='conteudo') Conteúdo
			textarea#conteudo.w3-input(name='conteudo' rows='8' maxlength='20000' required)= (p.conteudo || '')

			label(for='resourceId') Recurso associado (opcional)
			input#resourceId.w3-input(type='text' name='resourceId' value=(p.resourceId || '') placeholder='Deixa vazio se não se aplicar')

			button.w3-button.botao-principal(type='submit')= submitText
