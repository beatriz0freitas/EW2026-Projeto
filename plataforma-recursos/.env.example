# Auth
JWT_SECRET=change-me-local-dev
JWT_EXPIRES=24h
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
AUTH_COOKIE_NAME=ew.auth
AUTH_REFRESH_COOKIE_NAME=ew2026_refresh
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_ACCESS_MAX_AGE_MS=900000
AUTH_COOKIE_REFRESH_MAX_AGE_MS=604800000
AUTH_REFRESH_COOKIE_PATH=/sessions/refresh
AUTH_CORS_ORIGIN=http://localhost:16020

# Interface
# Obrigatório em produção
SESSION_SECRET=change-me-interface-session
SESSION_COOKIE_NAME=ew.sid

# API
AUTH_URL=http://auth:16027
AIP_DIR=/aip